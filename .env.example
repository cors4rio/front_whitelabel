# Copie para .env.local (que NUNCA vai para o Git). Todas as variáveis são opcionais.

# Marca da interface: nome de uma pasta de src/brands (padrão: claudaccount). Gravada no build.
BRAND=claudaccount

# Onde está a API. Em desenvolvimento o Next repassa /api/* para cá (mesma origem: sem CORS e o cookie de sessão funciona).
BACKEND_URL=http://localhost:8080

# Módulo de Notas Fiscais: "demo" (simulação no navegador), "api" (backend de verdade) ou vazio (módulo oculto).
# Padrão: demo em desenvolvimento, vazio em qualquer build de produção.
# NEXT_PUBLIC_NOTAS_FISCAIS=demo
